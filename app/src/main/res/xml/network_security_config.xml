<?xml version="1.0" encoding="utf-8"?>
<!-- Link API do người dùng tự nhập: cho phép cả http:// (vd Ollama trong mạng LAN 192.168.x.x) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
